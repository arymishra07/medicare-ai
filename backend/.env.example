# ---------------------------------------------------------------------------
# MediCare AI - backend environment (copy this file to .env)
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
# Easiest start: USE_IN_MEMORY_DB=true. Data persists in backend/.mongo-data.
# For a real database, set USE_IN_MEMORY_DB=false and provide MONGO_URI.
USE_IN_MEMORY_DB=true
MONGO_URI=mongodb://127.0.0.1:27017/medicare_ai
ALLOW_MEMORY_FALLBACK=true

# Auth - generate a long random value, e.g. `openssl rand -hex 48`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Demo data (creates admin/doctor/patient accounts only if DB is empty)
SEED_ON_START=true

# Optional AI provider. The chatbot works without a key using the built-in
# safety-focused health knowledge base. If set, it is used server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Rate limiting
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=40
CHAT_RATE_LIMIT_MAX=40
